FROM python:3.12.3-alpine
LABEL maintainer="Arnaud,Jorge"

RUN sed -i '2s/^# *//' /etc/apk/repositories && \
apk update && \
apk add openjdk17

ENV ACTIVEMQ_VERSION=6.3.2
ENV ACTIVEMQ=apache-activemq-$ACTIVEMQ_VERSION
ENV ACTIVEMQ_HOME=/opt/activemq

RUN apk add --update curl && \ 
rm -rf /var/cache/apk/* && \ 
mkdir -p /opt
#RUN curl -s -S https://dlcdn.apache.org/activemq/$ACTIVEMQ_VERSION/$ACTIVEMQ-bin.tar.gz | tar -xvz -C /opt
RUN curl -s -S -L https://www.apache.org/dyn/closer.cgi\?filename\=/activemq/$ACTIVEMQ_VERSION/$ACTIVEMQ-bin.tar.gz\&action\=download  | tar -xvz -C /opt
RUN mv /opt/$ACTIVEMQ $ACTIVEMQ_HOME


RUN addgroup -S activemq && \
adduser -S -H -G activemq -h $ACTIVEMQ_HOME activemq && \
chown -R activemq:activemq $ACTIVEMQ_HOME && \
chown -h activemq:activemq $ACTIVEMQ_HOME

# ActiveMQ 6.3 ships the console config in conf/jetty/. Bind the web console
# to all interfaces and allow non-loopback clients (authentication stays on).
RUN sed -i '/^jetty.http.port=8161$/a jetty.http.host=0.0.0.0' /opt/activemq/conf/jetty-spring.properties && \
    sed -i 's#<Item>::1</Item>#<Item>::1</Item>\n              <Item>0.0.0.0/0</Item>\n              <Item>::/0</Item>#' /opt/activemq/conf/jetty/jetty-security.xml && \
    grep -q '^jetty.http.host=0.0.0.0$' /opt/activemq/conf/jetty-spring.properties && \
    grep -q '<Item>0.0.0.0/0</Item>' /opt/activemq/conf/jetty/jetty-security.xml

# ActiveMQ 6.3 only permits POST on the Jolokia endpoint by default. AMQC reads
# broker data with GET, so allow it in addition to POST.
RUN sed -i 's#<method>post</method>#<method>post</method>\n    <method>get</method>#' /opt/activemq/conf/jolokia-access.xml && \
    grep -q '<method>get</method>' /opt/activemq/conf/jolokia-access.xml

# ActiveMQ 6.3 disables the extra transports by default. Re-enable the ones
# exposed by this image and keep the JMS transformer for AMQP.
RUN sed -E 's#^([[:space:]]*)<!-- (<transportConnector name="(amqp|stomp|mqtt|ws)".*/>) -->#\1\2#' \
        /opt/activemq/conf/activemq.xml | \
    sed -E 's#(<transportConnector name="amqp" uri="amqp://[^"]*)#\1\&amp;transport.transformer=jms#' \
        > /opt/activemq/conf/activemq.xml.tmp && \
    mv /opt/activemq/conf/activemq.xml.tmp /opt/activemq/conf/activemq.xml && \
    grep -q 'transport.transformer=jms' /opt/activemq/conf/activemq.xml

RUN curl -LOk --header "Cache-Control: no-cache, no-store, must-revalidate" \
    --header "Pragma: no-cache" \
    --header "Expires: 0" \
    https://github.com/snuids/AMQC/archive/master.zip && \
    unzip master.zip && \
    rm master.zip && \
    mv ./AMQC-master/ /opt/static && \
    mv /opt/static/server/ /opt/

# Use the server code from this checkout so local fixes are included.
COPY server/main.py server/requirements.txt /opt/server/

RUN pip3 install -r /opt/server/requirements.txt

WORKDIR /opt/server

CMD sed -i "s/^rootLogger.level=.*/rootLogger.level=${ACTIVEMQ_LOG_LEVEL:-INFO}/" /opt/activemq/conf/log4j2.properties; \
echo "${ACTIVEMQ_ADMIN_LOGIN}:${ACTIVEMQ_ADMIN_PASSWORD}" > /opt/activemq/conf/users.properties; \
echo "admins=${ACTIVEMQ_ADMIN_LOGIN}" > /opt/activemq/conf/groups.properties; \
/opt/activemq/bin/activemq start; \
uvicorn main:app --host 0.0.0.0 --port 8180



EXPOSE 1883 5672 8161 8168 8180 61613 61614 61616
